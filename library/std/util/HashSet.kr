package std.util;

class HashSet<T extends Hashable<T>> implements Set<T> {
    @Intrinsic
    int size();

    @Intrinsic
    mut boolean add(T value);

    @Intrinsic
    mut boolean remove(&T value);

    @Intrinsic
    boolean contains(&T value);

    @Intrinsic
    mut void clear();

    Iterator<T> iterator() {
        return new HashSetIterator<>(this);
    }

    String toString() {
        String text = "[";
        boolean first = true;
        for (&T value : this) {
            if (!first) {
                text = text + ", ";
            }
            first = false;
            text = text + value;
        }
        return text + "]";
    }

    @Intrinsic
    int slotCount();

    @Intrinsic
    (&T)? slotAt(int index);
}
