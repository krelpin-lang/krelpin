package std.util;

/**
 * A collection that contains no duplicate elements.
 *
 * <pre>{@code
 * Set<String> seen = new HashSet<>();
 * if (!seen.add(name)) {
 *     Console.println("$name appears twice");
 * }
 * }</pre>
 *
 * @param <T> the type of the elements
 * @see HashSet
 */
interface Set<T> extends Iterable<T> {
    /**
     * Returns the number of elements in this set.
     *
     * @return the number of elements
     */
    int size();

    /**
     * Returns whether this set contains no elements.
     *
     * @return {@code true} if {@link #size} is 0
     */
    boolean isEmpty() {
        return this.size() == 0;
    }

    /**
     * Adds an element to this set if no equal element is present.
     *
     * @param value the element to add
     * @return {@code true} if the element was added, {@code false} if an equal
     *         element was already present
     */
    mut boolean add(T value);

    /**
     * Removes the element equal to a value, if it is present.
     *
     * @param value the value to remove
     * @return {@code true} if an element was removed
     */
    mut boolean remove(&T value);

    /**
     * Returns whether this set contains an element equal to a value.
     *
     * @param value the value to search for
     * @return {@code true} if an equal element is present
     */
    boolean contains(&T value);

    /** Removes all elements from this set. */
    static <T extends Hashable<T>> Set<T> of() {
        Set<T> values = new LinkedHashSet<>();
        return values;
    }

    static <T extends Hashable<T>> Set<T> of(T a) {
        Set<T> values = new LinkedHashSet<>();
        values.add(a);
        return values;
    }

    static <T extends Hashable<T>> Set<T> of(T a, T b) {
        Set<T> values = new LinkedHashSet<>();
        values.add(a);
        values.add(b);
        return values;
    }

    static <T extends Hashable<T>> Set<T> of(T a, T b, T c) {
        Set<T> values = new LinkedHashSet<>();
        values.add(a);
        values.add(b);
        values.add(c);
        return values;
    }

    static <T extends Hashable<T>> Set<T> of(T a, T b, T c, T d) {
        Set<T> values = new LinkedHashSet<>();
        values.add(a);
        values.add(b);
        values.add(c);
        values.add(d);
        return values;
    }

    static <T extends Hashable<T>> Set<T> of(T a, T b, T c, T d, T e) {
        Set<T> values = new LinkedHashSet<>();
        values.add(a);
        values.add(b);
        values.add(c);
        values.add(d);
        values.add(e);
        return values;
    }

    static <T extends Hashable<T>> Set<T> of(T a, T b, T c, T d, T e, T f) {
        Set<T> values = new LinkedHashSet<>();
        values.add(a);
        values.add(b);
        values.add(c);
        values.add(d);
        values.add(e);
        values.add(f);
        return values;
    }

    static <T extends Hashable<T>> Set<T> of(T a, T b, T c, T d, T e, T f, T g) {
        Set<T> values = new LinkedHashSet<>();
        values.add(a);
        values.add(b);
        values.add(c);
        values.add(d);
        values.add(e);
        values.add(f);
        values.add(g);
        return values;
    }

    static <T extends Hashable<T>> Set<T> of(T a, T b, T c, T d, T e, T f, T g, T h) {
        Set<T> values = new LinkedHashSet<>();
        values.add(a);
        values.add(b);
        values.add(c);
        values.add(d);
        values.add(e);
        values.add(f);
        values.add(g);
        values.add(h);
        return values;
    }

    Set<T> clone() where T extends Cloneable<T> & Hashable<T> {
        Set<T> copy = new HashSet<>();
        for (&T value : this) {
            copy.add(value.clone());
        }
        return copy;
    }

    boolean equals(&Set<T> other) {
        if (this.size() != other.size()) {
            return false;
        }
        for (&T value : this) {
            if (!other.contains(value)) {
                return false;
            }
        }
        return true;
    }

    int hashCode() where T extends Hashable<T> {
        int hash = 0;
        for (&T value : this) {
            hash = hash + value.hashCode();
        }
        return hash;
    }

    mut void clear();
}
