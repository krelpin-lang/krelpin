package std.util;

class ArrayList<T> implements List<T> {
    @Intrinsic
    int size();

    @Intrinsic
    &T get(int index);

    @Intrinsic
    mut T set(int index, T value);

    @Intrinsic
    mut void add(T value);

    @Intrinsic
    mut void add(int index, T value);

    @Intrinsic
    mut T remove(int index);

    @Intrinsic
    int indexOf(&T value) where T extends Equatable<T>;

    @Intrinsic
    mut void clear();

    Iterator<T> iterator() {
        return new ArrayListIterator<>(this);
    }

    String toString() {
        String text = "[";
        for (int i = 0; i < this.size(); i++) {
            if (i > 0) {
                text = text + ", ";
            }
            text = text + this.get(i);
        }
        return text + "]";
    }
}
