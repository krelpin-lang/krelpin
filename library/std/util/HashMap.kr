package std.util;

class HashMap<K extends Hashable<K>, V> implements Map<K, V> {
    @Intrinsic
    int size();

    @Intrinsic
    (&[this] V)? get(&K key);

    @Intrinsic
    mut V? put(K key, V value);

    @Intrinsic
    mut V? remove(&K key);

    @Intrinsic
    boolean containsKey(&K key);

    @Intrinsic
    mut void clear();

    @Intrinsic
    Set<&[this] K> keySet();

    @Intrinsic
    List<&[this] V> values();
}
