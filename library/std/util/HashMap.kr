package std.util;

class HashMap<K extends Hashable<K>, V> implements Map<K, V> {
    @Intrinsic
    int size();

    @Intrinsic
    (&V)? get(&K key);

    @Intrinsic
    mut V? put(K key, V value);

    @Intrinsic
    mut V? remove(&K key);

    @Intrinsic
    boolean containsKey(&K key);

    @Intrinsic
    mut void clear();

    @Intrinsic
    Set<&K> keySet();

    @Intrinsic
    List<&V> values();

    String toString() {
        String text = "{";
        boolean first = true;
        for (&K key : this.keySet()) {
            if (!first) {
                text = text + ", ";
            }
            first = false;
            text = text + key + "=" + this.get(key);
        }
        return text + "}";
    }
}
