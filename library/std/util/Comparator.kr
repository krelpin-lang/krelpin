package std.util;

import std.function.Function;

interface Comparator<T> {
    mut int compare(&T a, &T b);

    static <T, K extends Comparable<K>> Comparator<T> comparing(Function<&T, K> key) {
        return move (a, b) -> key.apply(a).compareTo(&key.apply(b));
    }

    static <T extends Comparable<T>> Comparator<T> naturalOrder() {
        return (a, b) -> a.compareTo(b);
    }

    move Comparator<T> thenComparing(Comparator<T> next) {
        Comparator<T> first = this;
        return move (a, b) -> {
            int order = first.compare(a, b);
            return order != 0 ? order : next.compare(a, b);
        };
    }

    move <K extends Comparable<K>> Comparator<T> thenComparing(Function<&T, K> key) {
        return this.thenComparing(Comparator.comparing(key));
    }

    move Comparator<T> reversed() {
        Comparator<T> original = this;
        return move (a, b) -> original.compare(b, a);
    }
}
