package std.util;

/**
 * An iterator over a collection, which returns its elements one at a time.
 *
 * <p>An iterator borrows its collection, so the collection cannot be
 * modified while the iterator is in use.
 *
 * <pre>{@code
 * Iterator<String> names = list.iterator();
 * while (names.hasNext()) {
 *     Console.println(names.next());
 * }
 * }</pre>
 *
 * <p>An enhanced {@code for} loop over an {@link Iterable} does the same.
 *
 * @param <T> the type of the elements
 */
interface Iterator<T> borrows src {
    /**
     * Returns whether the iteration has more elements.
     *
     * @return {@code true} if {@link #next} would return an element
     */
    boolean hasNext();

    /**
     * Returns the next element in the iteration and advances past it.
     *
     * @return a reference to the next element
     * @throws IllegalStateException if the iteration has no more elements
     */
    mut &T next() borrows src;
}
