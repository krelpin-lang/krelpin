package std.util;

import std.function.Predicate;

/**
 * An ordered collection whose elements are accessed by their position.
 *
 * <p>Indices are zero-based. Methods that take an index throw
 * {@link IndexOutOfBoundsException} if it is out of range.
 *
 * <p>A list owns its elements: {@link #add} moves a value into the list,
 * {@link #remove} moves it back out, and {@link #get} returns a reference
 * that keeps the list borrowed while it is in use.
 *
 * <pre>{@code
 * List<String> names = new ArrayList<>();
 * names.add("Ada");
 * names.add("Grace");
 * names.sort();
 * &String first = names.get(0);
 * }</pre>
 *
 * @param <T> the type of the elements
 * @see ArrayList
 */
interface List<T> extends Iterable<T> {
    /**
     * Returns the number of elements in this list.
     *
     * @return the number of elements
     */
    int size();

    /**
     * Returns whether this list contains no elements.
     *
     * @return {@code true} if {@link #size} is 0
     */
    boolean isEmpty() {
        return this.size() == 0;
    }

    /**
     * Returns the element at the specified position.
     *
     * @param index the index of the element
     * @return a reference to the element
     * @throws IndexOutOfBoundsException if {@code index} is negative or not
     *         less than {@link #size}
     */
    &T get(int index);

    /**
     * Returns the element at the specified position for modification.
     *
     * <pre>{@code
     * List<StringBuilder> lines = ...;
     * lines.getMut(0).append(" (edited)");
     * }</pre>
     *
     * @param index the index of the element
     * @return a mutable reference to the element
     * @throws IndexOutOfBoundsException if {@code index} is negative or not
     *         less than {@link #size}
     */
    mut &mut T getMut(int index);

    /**
     * Returns the first element of this list.
     *
     * @return a reference to the first element, or {@code null} if this list
     *         is empty
     */
    (&T)? first() {
        if (this.isEmpty()) {
            return null;
        }
        return this.get(0);
    }

    /**
     * Returns the last element of this list.
     *
     * @return a reference to the last element, or {@code null} if this list is
     *         empty
     */
    (&T)? last() {
        if (this.isEmpty()) {
            return null;
        }
        return this.get(this.size() - 1);
    }

    /**
     * Replaces the element at the specified position.
     *
     * @param index the index of the element to replace
     * @param value the new element
     * @return the element previously at {@code index}
     * @throws IndexOutOfBoundsException if {@code index} is negative or not
     *         less than {@link #size}
     */
    mut T set(int index, T value);

    /**
     * Appends an element to the end of this list.
     *
     * @param value the element to append
     */
    mut void add(T value);

    /**
     * Inserts an element at the specified position, shifting the element at
     * that position and all subsequent elements one position up.
     *
     * @param index the index to insert at; {@link #size} appends
     * @param value the element to insert
     * @throws IndexOutOfBoundsException if {@code index} is negative or
     *         greater than {@link #size}
     */
    mut void add(int index, T value);

    /**
     * Removes the element at the specified position, shifting all subsequent
     * elements one position down.
     *
     * @param index the index of the element to remove
     * @return the removed element
     * @throws IndexOutOfBoundsException if {@code index} is negative or not
     *         less than {@link #size}
     */
    mut T remove(int index);

    /**
     * Removes every element that satisfies a predicate. The remaining
     * elements keep their relative order.
     *
     * <pre>{@code
     * numbers.removeIf(n -> n % 2 == 0); // keeps the odd numbers
     * }</pre>
     *
     * @param filter the predicate, which returns {@code true} for the elements
     *        to remove
     * @return the number of elements removed
     */
    mut int removeIf(Predicate<&T> filter) {
        int count = this.size();
        boolean[] doomed = new boolean[count];
        for (int index = 0; index < count; index++) {
            doomed[index] = filter.test(this.get(index));
        }
        // Move the survivors to the front in order, then drop the tail.
        int kept = 0;
        for (int index = 0; index < count; index++) {
            if (!doomed[index]) {
                if (kept != index) {
                    this.swap(kept, index);
                }
                kept++;
            }
        }
        for (int index = count - 1; index >= kept; index--) {
            this.remove(index);
        }
        return count - kept;
    }

    /**
     * Exchanges the elements at two positions.
     *
     * @param a the index of the first element
     * @param b the index of the second element
     * @throws IndexOutOfBoundsException if either index is out of range
     */
    mut void swap(int a, int b);

    /** Reverses the order of the elements in this list. */
    mut void reverse() {
        int low = 0;
        int high = this.size() - 1;
        while (low < high) {
            this.swap(low, high);
            low++;
            high--;
        }
    }

    /**
     * Returns whether this list contains an element equal to a value.
     *
     * @param value the value to search for
     * @return {@code true} if an element equal to {@code value} is present
     */
    boolean contains(&T value) where T extends Equatable<T> {
        return this.indexOf(value) >= 0;
    }

    /**
     * Returns the index of the first element equal to a value.
     *
     * @param value the value to search for
     * @return the index of the first equal element, or -1 if there is none
     */
    int indexOf(&T value) where T extends Equatable<T>;

    /**
     * Returns the index of the last element equal to a value.
     *
     * @param value the value to search for
     * @return the index of the last equal element, or -1 if there is none
     */
    int lastIndexOf(&T value) where T extends Equatable<T> {
        for (int index = this.size() - 1; index >= 0; index--) {
            if (this.get(index).equals(value)) {
                return index;
            }
        }
        return -1;
    }

    /**
     * Sorts this list into the natural order of its elements.
     *
     * <p>The sort is stable: equal elements keep their relative order.
     */
    mut void sort() where T extends Comparable<T> {
        this.sort((a, b) -> a.compareTo(b));
    }

    /**
     * Sorts this list into the order defined by a comparator.
     *
     * <p>The sort is stable, so elements that the comparator considers equal
     * keep their relative order. It performs O(n log n) comparisons.
     *
     * <pre>{@code
     * words.sort((a, b) -> a.length() - b.length());
     * }</pre>
     *
     * @param comparator the comparator that defines the order
     */
    mut void sort(Comparator<T> comparator) {
        int count = this.size();
        if (count < 2) {
            return;
        }
        // Merge-sort the indices, then move each element to its place.
        int[] order = new int[count];
        int[] merged = new int[count];
        for (int i = 0; i < count; i++) {
            order[i] = i;
        }
        for (int width = 1; width < count; width = width * 2) {
            for (int low = 0; low < count; low = low + 2 * width) {
                int middle = Math.min(low + width, count);
                int high = Math.min(low + 2 * width, count);
                int left = low;
                int right = middle;
                int out = low;
                while (left < middle && right < high) {
                    if (comparator.compare(this.get(order[right]), this.get(order[left])) < 0) {
                        merged[out] = order[right];
                        right++;
                    } else {
                        merged[out] = order[left];
                        left++;
                    }
                    out++;
                }
                while (left < middle) {
                    merged[out] = order[left];
                    left++;
                    out++;
                }
                while (right < high) {
                    merged[out] = order[right];
                    right++;
                    out++;
                }
            }
            for (int i = 0; i < count; i++) {
                order[i] = merged[i];
            }
        }
        // `origin[p]` is the original index of the element now at `p`, and
        // `place[i]` is where the element that started at `i` is now.
        int[] origin = new int[count];
        int[] place = new int[count];
        for (int i = 0; i < count; i++) {
            origin[i] = i;
            place[i] = i;
        }
        for (int target = 0; target < count; target++) {
            int wanted = order[target];
            int from = place[wanted];
            if (from != target) {
                this.swap(target, from);
                int displaced = origin[target];
                origin[from] = displaced;
                place[displaced] = from;
                origin[target] = wanted;
                place[wanted] = target;
            }
        }
    }

    /** Removes all elements from this list. */
    mut void clear();
}
