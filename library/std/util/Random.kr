package std.util;

final class Random {
    private long state;

    Random() {
        this.state = System.nanoTime() ^ 0x5DEECE66DL;
    }

    Random(long seed) {
        this.state = seed;
    }

    mut long nextLong() {
        this.state = this.state + 0x9E3779B97F4A7C15L;
        long mixed = this.state;
        mixed = (mixed ^ (mixed >>> 30)) * 0xBF58476D1CE4E5B9L;
        mixed = (mixed ^ (mixed >>> 27)) * 0x94D049BB133111EBL;
        return mixed ^ (mixed >>> 31);
    }

    mut int nextInt() {
        return (int) (this.nextLong() >>> 32);
    }

    mut int nextInt(int bound) {
        if (bound <= 0) {
            throw new IllegalArgumentException("the bound must be positive, but it is $bound");
        }
        long limit = long.MAX_VALUE - long.MAX_VALUE % bound;
        while (true) {
            long candidate = this.nextLong() >>> 1;
            if (candidate < limit) {
                return (int) (candidate % bound);
            }
        }
    }

    mut int nextInt(int low, int high) {
        if (low >= high) {
            throw new IllegalArgumentException("the range $low..$high is empty");
        }
        long span = (long) high - (long) low;
        long limit = long.MAX_VALUE - long.MAX_VALUE % span;
        while (true) {
            long candidate = this.nextLong() >>> 1;
            if (candidate < limit) {
                return (int) ((long) low + candidate % span);
            }
        }
    }

    mut double nextDouble() {
        return (double) (this.nextLong() >>> 11) / 9007199254740992.0;
    }

    mut boolean nextBoolean() {
        return this.nextLong() < 0L;
    }

    mut <T> void shuffle(&mut List<T> values) {
        for (int index = values.size() - 1; index > 0; index--) {
            values.swap(index, this.nextInt(index + 1));
        }
    }
}
