package std.util;

interface Map<K, V> {
    int size(&this);

    boolean isEmpty(&this) {
        return this.size() == 0;
    }

    V? get(&this, K key);

    V? put(&mut this, K key, V value);

    V? remove(&mut this, K key);

    boolean containsKey(&this, K key);

    void clear(&mut this);

    Set<K> keySet(&this);

    List<V> values(&this);
}
