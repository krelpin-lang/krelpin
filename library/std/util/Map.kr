package std.util;

import std.function.BiConsumer;

/**
 * An object that maps keys to values, in which each key appears at most
 * once.
 *
 * <p>A map owns its keys and values: {@link #put} moves them into the map,
 * {@link #remove} moves the value back out, and {@link #get} returns a
 * reference to it.
 *
 * <pre>{@code
 * Map<String, int> ages = new HashMap<>();
 * ages.put("Ada", 36);
 * (&int)? age = ages.get(&"Ada");
 * if (age != null) {
 *     Console.println("Ada is $age");
 * }
 * }</pre>
 *
 * @param <K> the type of the keys
 * @param <V> the type of the values
 * @see HashMap
 */
interface Map<K, V> {
    /**
     * Returns the number of entries in this map.
     *
     * @return the number of entries
     */
    int size();

    /**
     * Returns whether this map contains no entries.
     *
     * @return {@code true} if {@link #size} is 0
     */
    boolean isEmpty() {
        return this.size() == 0;
    }

    /**
     * Returns the value associated with a key.
     *
     * @param key the key to look up
     * @return a reference to the value, or {@code null} if there is no entry
     *         for {@code key}
     */
    (&V)? get(&K key);

    /**
     * Returns the value associated with a key, for modification.
     *
     * <pre>{@code
     * Map<String, List<String>> groups = new HashMap<>();
     * groups.put("odd", new ArrayList<>());
     * (&mut List<String>)? odd = groups.getMut(&"odd");
     * if (odd != null) {
     *     odd.add("one");
     * }
     * }</pre>
     *
     * @param key the key to look up
     * @return a mutable reference to the value, or {@code null} if there is
     *         no entry for {@code key}
     */
    mut (&mut V)? getMut(&K key);

    /**
     * Associates a value with a key, replacing any previous value.
     *
     * @param key the key
     * @param value the value to associate with {@code key}
     * @return the previous value, or {@code null} if there was no entry for
     *         {@code key}
     */
    mut V? put(K key, V value);

    /**
     * Removes the entry for a key.
     *
     * @param key the key whose entry is removed
     * @return the removed value, or {@code null} if there was no entry for
     *         {@code key}
     */
    mut V? remove(&K key);

    /**
     * Returns whether this map contains an entry for a key.
     *
     * @param key the key to look up
     * @return {@code true} if there is an entry for {@code key}
     */
    boolean containsKey(&K key);

    /** Removes all entries from this map. */
    mut boolean putIfAbsent(K key, V value) {
        if (this.containsKey(&key)) {
            return false;
        }
        this.put(key, value);
        return true;
    }

    boolean containsValue(&V value) where V extends Equatable<V> {
        for (&V candidate : this.values()) {
            if (candidate.equals(value)) {
                return true;
            }
        }
        return false;
    }

    void forEach(BiConsumer<&K, &V> action) {
        for (&K key : this.keySet()) {
            (&V)? value = this.get(key);
            if (value != null) {
                action.accept(key, value);
            }
        }
    }

    Map<K, V> clone() where K extends Cloneable<K> & Hashable<K>, V extends Cloneable<V> {
        Map<K, V> copy = new HashMap<>();
        for (&K key : this.keySet()) {
            (&V)? value = this.get(key);
            if (value != null) {
                copy.put(key.clone(), value.clone());
            }
        }
        return copy;
    }

    boolean equals(&Map<K, V> other) where V extends Equatable<V> {
        if (this.size() != other.size()) {
            return false;
        }
        for (&K key : this.keySet()) {
            (&V)? mine = this.get(key);
            (&V)? theirs = other.get(key);
            if (mine == null || theirs == null || !mine.equals(theirs)) {
                return false;
            }
        }
        return true;
    }

    int hashCode() where K extends Hashable<K>, V extends Hashable<V> {
        int hash = 0;
        for (&K key : this.keySet()) {
            (&V)? value = this.get(key);
            hash = hash + (key.hashCode() ^ (value != null ? value.hashCode() : 0));
        }
        return hash;
    }

    mut void clear();

    /**
     * Returns the keys of this map.
     *
     * @return a set of references to the keys
     */
    Set<&K> keySet();

    /**
     * Returns the values of this map, in the same order as
     * {@link #keySet}.
     *
     * @return a list of references to the values
     */
    List<&V> values();
}
