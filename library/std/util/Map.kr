package std.util;

interface Map<K, V> {
    int size();

    boolean isEmpty() {
        return this.size() == 0;
    }

    V? get(K key);

    mut V? put(K key, V value);

    mut V? remove(K key);

    boolean containsKey(K key);

    mut void clear();

    Set<K> keySet();

    List<V> values();
}
