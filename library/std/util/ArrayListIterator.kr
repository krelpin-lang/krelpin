package std.util;

/**
 * The iterator returned by {@link ArrayList#iterator}, which visits the
 * elements in order.
 *
 * @param <T> the type of the elements
 */
final class ArrayListIterator<T> borrows src implements Iterator<T> {
    private &ArrayList<T> list;
    private int next;

    /**
     * Constructs an iterator positioned at the first element of a list.
     *
     * @param list the list to iterate over
     */
    ArrayListIterator(&ArrayList<T> list) keeps list {
        this.list = list;
        this.next = 0;
    }

    boolean hasNext() {
        return this.next < this.list.size();
    }

    mut &T next() borrows src {
        int index = this.next;
        if (index >= this.list.size()) {
            throw new IllegalStateException("the iterator has no more elements");
        }
        this.next = index + 1;
        return this.list.get(index);
    }
}
