package std.sync;

final class AtomicInt {
    private int value;

    AtomicInt(int value) {
        this.value = value;
    }

    @Intrinsic
    int get();

    @Intrinsic
    void set(int value);

    @Intrinsic
    boolean compareAndSet(int expected, int value);

    @Intrinsic
    int increment();

    @Intrinsic
    int decrement();

    @Intrinsic
    int addAndGet(int delta);
}
