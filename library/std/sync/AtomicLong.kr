package std.sync;

final class AtomicLong {
    private long value;

    AtomicLong(long value) {
        this.value = value;
    }

    @Intrinsic
    long get();

    @Intrinsic
    void set(long value);

    @Intrinsic
    boolean compareAndSet(long expected, long value);

    @Intrinsic
    long increment();

    @Intrinsic
    long decrement();

    @Intrinsic
    long addAndGet(long delta);
}
