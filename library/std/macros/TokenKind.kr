package std.macros;

/** The kind of a {@link Token}. */
enum TokenKind {
    /**
     * An identifier or keyword, such as {@code count}, {@code String} or
     * {@code class}.
     */
    IDENT,
    /**
     * A number, character, string or boolean literal, as written in the
     * source.
     */
    LITERAL,
    /**
     * An operator or punctuation token, such as <code>{</code>, {@code ->}
     * or {@code >>=}.
     */
    PUNCT,
    /** A documentation comment, which begins with two asterisks. */
    DOC
}
