package std.macros;

/** The kind of type declaration an `Item` holds. */
enum ItemKind {
    /** A `class`. */
    CLASS,
    /** A `record`, whose components `Item.components` returns. */
    RECORD,
    /** An `interface`. */
    INTERFACE,
    /** An `enum`. Its constants aren't members, so `Item.members` skips them. */
    ENUM
}
