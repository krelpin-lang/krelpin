package std.macros;

/** The kind of type declaration an {@link Item} holds. */
enum ItemKind {
    /** A class. */
    CLASS,
    /** A record, whose components {@link Item#components} returns. */
    RECORD,
    /** An interface. */
    INTERFACE,
    /**
     * An enum. Its constants are not members, so {@link Item#members}
     * omits them.
     */
    ENUM
}
