package std.macros;

/** The kind of declaration a `Member` holds. */
enum MemberKind {
    /** A field, with or without an initializer, or a record component. */
    FIELD,
    /** A method, with or without a body. */
    METHOD,
    /** A constructor. */
    CONSTRUCTOR,
    /** A nested class, record, interface or enum. */
    TYPE,
    /** A bare `{ ... }` block in a class body. */
    INITIALIZER
}
