package std.lang;

/**
 * The root of the class hierarchy. Every class has {@code Object} as a
 * superclass, directly or indirectly.
 */
class Object {
    /**
     * Returns a string representation of this object.
     *
     * <p>String concatenation, string interpolation and
     * {@link Console#println} call this method to convert an object to text.
     * The default implementation returns the class name followed by the
     * object's address, for example {@code Money@6000014e8020}. Records
     * return their components, for example {@code Point[x=1, y=2]}, and enum
     * variants return their name.
     *
     * <p>Subclasses should override this method to return a concise,
     * human-readable description:
     *
     * <pre>{@code
     * class Money {
     *     long cents;
     *
     *     String toString() {
     *         return "${this.cents / 100}.${(this.cents % 100).format("02")}";
     *     }
     * }
     * }</pre>
     *
     * @return a string representation of this object
     */
    @Intrinsic
    String toString();

    /**
     * Returns the string representation of this object formatted according
     * to a format specification.
     *
     * <p>{@code value.format(spec)} is equivalent to the interpolation
     * {@code "${value:spec}"}.
     *
     * @param spec the format specification, as described in {@link Format}
     * @return the formatted string
     * @throws IllegalArgumentException if {@code spec} is not a valid
     *         format specification
     */
    String format(String spec) {
        return Format.text(this.toString(), spec);
    }
}
