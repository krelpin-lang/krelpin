package std.lang;

final class Byte implements Comparable<Byte> {
    public const byte MIN_VALUE = -128;
    public const byte MAX_VALUE = 127;

    private byte value;

    Byte(byte value) {
        this.value = value;
    }

    byte byteValue(&this) {
        return this.value;
    }

    int compareTo(&this, Byte other) {
        return Byte.compare(this.value, other.value);
    }

    int compare(byte a, byte b) {
        if (a < b) {
            return -1;
        }
        return a > b ? 1 : 0;
    }

    Byte valueOf(byte value) {
        return new Byte(value);
    }

    @Intrinsic
    byte parseByte(String text);
}
