package std.lang;

/**
 * A type whose values can be used as keys in a {@code HashMap} or as
 * elements of a {@code HashSet}.
 *
 * <p>Values that are equal according to {@link Equatable#equals} must
 * return the same {@link #hashCode}. Unequal values may share a hash code,
 * but hash tables perform better when they rarely do.
 *
 * <p>Records implement this interface automatically by combining the hash
 * codes of their components.
 *
 * <p>A key must not change in a way that affects its hash code while it is
 * in a hash table; otherwise the table can no longer find it.
 *
 * @param <T> the type of values this value can be compared with
 * @see std.util.HashMap
 * @see std.util.HashSet
 */
interface Hashable<T> extends Equatable<T> {
    /**
     * Returns a hash code for this value, consistent with
     * {@link Equatable#equals}.
     *
     * @return a hash code for this value
     */
    int hashCode();
}
