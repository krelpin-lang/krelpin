package std.lang;

final class Float implements Comparable<Float> {
    public const float MIN_VALUE = 1.4e-45f;
    public const float MAX_VALUE = 3.4028235e38f;

    private float value;

    Float(float value) {
        this.value = value;
    }

    float floatValue(&this) {
        return this.value;
    }

    int compareTo(&this, Float other) {
        return Float.compare(this.value, other.value);
    }

    int compare(float a, float b) {
        if (a < b) {
            return -1;
        }
        return a > b ? 1 : 0;
    }

    Float valueOf(float value) {
        return new Float(value);
    }

    @Intrinsic
    float parseFloat(String text);
}
