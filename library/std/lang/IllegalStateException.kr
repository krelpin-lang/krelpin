package std.lang;

/**
 * Thrown when a method is called at a time when the object is not in an
 * appropriate state for it, such as reading from an exhausted iterator.
 */
class IllegalStateException extends RuntimeException {
    /** Constructs an exception with no detail message. */
    IllegalStateException() {
        super();
    }

    /**
     * Constructs an exception with the specified detail message.
     *
     * @param message the detail message, which describes what went wrong
     */
    IllegalStateException(String message) {
        super(message);
    }
}
