package std.lang;

/** The common superclass of all enums. */
abstract class Enum {
    /**
     * Returns the name of this variant, exactly as declared.
     *
     * @return the name of this variant, for example {@code "RED"}
     */
    @Intrinsic
    String name();

    /**
     * Returns the position of this variant in its enum declaration.
     *
     * @return the zero-based position of this variant
     */
    @Intrinsic
    int ordinal();
}
