package std.lang;

/**
 * Thrown when a cast converts a value to a type that it is not an
 * instance of.
 *
 * <pre>{@code
 * Object value = "text";
 * StringBuilder builder = (StringBuilder) value; // throws ClassCastException
 * }</pre>
 *
 * <p>Test the type with {@code instanceof} to avoid the exception:
 *
 * <pre>{@code
 * if (value instanceof String text) {
 *     Console.println(text.length());
 * }
 * }</pre>
 */
class ClassCastException extends RuntimeException {
    /** Constructs an exception with no detail message. */
    ClassCastException() {
        super();
    }

    /**
     * Constructs an exception with the specified detail message.
     *
     * @param message the detail message, which describes what went wrong
     */
    ClassCastException(String message) {
        super(message);
    }
}
