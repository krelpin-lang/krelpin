package std.lang;

/**
 * The superclass of conditions that a program is expected to handle.
 *
 * <p>Exceptions are checked: a method that can throw one must declare it in
 * its {@code throws} clause, and every caller must either catch it or
 * declare it in turn. The exception to this rule is
 * {@link RuntimeException} and its subclasses, which are unchecked.
 *
 * <pre>{@code
 * static String firstLine(String path) throws IOException {
 *     return Files.readLines(path)[0];
 * }
 * }</pre>
 */
class Exception extends Throwable {
    /** Constructs an exception with no detail message. */
    Exception() {
        super();
    }

    /**
     * Constructs an exception with the specified detail message.
     *
     * @param message the detail message, which describes what went wrong
     */
    Exception(String message) {
        super(message);
    }
}
