package std.lang;

/**
 * The superclass of serious failures from which a program is not expected
 * to recover.
 *
 * <p>Errors are unchecked. They should not be caught, except at the top
 * level of a program in order to report them.
 */
class Error extends Throwable {
    /** Constructs an error with no detail message. */
    Error() {
        super();
    }

    /**
     * Constructs an error with the specified detail message.
     *
     * @param message the detail message, which describes what went wrong
     */
    Error(String message) {
        super(message);
    }
}
