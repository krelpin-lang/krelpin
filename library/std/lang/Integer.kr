package std.lang;

final class Integer implements Comparable<Integer> {
    public const int MIN_VALUE = -2147483648;
    public const int MAX_VALUE = 2147483647;

    private int value;

    Integer(int value) {
        this.value = value;
    }

    int intValue(&this) {
        return this.value;
    }

    int compareTo(&this, Integer other) {
        return Integer.compare(this.value, other.value);
    }

    int compare(int a, int b) {
        if (a < b) {
            return -1;
        }
        return a > b ? 1 : 0;
    }

    Integer valueOf(int value) {
        return new Integer(value);
    }

    @Intrinsic
    int parseInt(String text);

    @Intrinsic
    String toString(int value);
}
