package std.lang;

final class Short implements Comparable<Short> {
    public const short MIN_VALUE = -32768;
    public const short MAX_VALUE = 32767;

    private short value;

    Short(short value) {
        this.value = value;
    }

    short shortValue(&this) {
        return this.value;
    }

    int compareTo(&this, Short other) {
        return Short.compare(this.value, other.value);
    }

    int compare(short a, short b) {
        if (a < b) {
            return -1;
        }
        return a > b ? 1 : 0;
    }

    Short valueOf(short value) {
        return new Short(value);
    }

    @Intrinsic
    short parseShort(String text);
}
