package std.lang;

/**
 * The superclass of exceptions that indicate programming errors, such as
 * an index out of bounds or an invalid argument.
 *
 * <p>Runtime exceptions are unchecked: methods do not need to declare them
 * in a {@code throws} clause, and callers do not need to catch them. For a
 * failure that callers are expected to handle, such as an I/O error, extend
 * {@link Exception} instead.
 */
class RuntimeException extends Exception {
    /** Constructs a runtime exception with no detail message. */
    RuntimeException() {
        super();
    }

    /**
     * Constructs a runtime exception with the specified detail message.
     *
     * @param message the detail message, which describes what went wrong
     */
    RuntimeException(String message) {
        super(message);
    }
}
