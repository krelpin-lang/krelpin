package std.lang;

/**
 * Provides access to standard input, standard output and standard error.
 *
 * <p>The {@code print} and {@code println} methods write to standard
 * output, and {@code eprint} and {@code eprintln} write to standard error.
 * Values are converted to text the same way as in string concatenation;
 * {@code null} is written as {@code null}.
 *
 * <pre>{@code
 * Console.println("Hello, world!");
 * Console.eprintln("warning: ${count} files skipped");
 * String? line = Console.readLine();
 * }</pre>
 *
 * <p>All methods are thread-safe, and each call writes its text as a single
 * unit. Standard output is flushed before anything is written to standard
 * error and before a line is read, so that prompts and messages appear in
 * order.
 */
final class Console {
    private Console() {}

    /**
     * Writes the value to standard output.
     *
     * @param value the value to write
     */
    @Intrinsic
    static void print(Object? value);

    /**
     * Writes the value to standard output.
     *
     * @param value a reference to the value to write
     */
    @Intrinsic
    static void print(&Object? value);

    /** Writes a line separator to standard output. */
    @Intrinsic
    static void println();

    /**
     * Writes the value and a line separator to standard output.
     *
     * @param value the value to write
     */
    @Intrinsic
    static void println(Object? value);

    /**
     * Writes the value and a line separator to standard output.
     *
     * @param value a reference to the value to write
     */
    @Intrinsic
    static void println(&Object? value);

    /**
     * Writes the value to standard error.
     *
     * @param value the value to write
     */
    @Intrinsic
    static void eprint(Object? value);

    /**
     * Writes the value to standard error.
     *
     * @param value a reference to the value to write
     */
    @Intrinsic
    static void eprint(&Object? value);

    /** Writes a line separator to standard error. */
    @Intrinsic
    static void eprintln();

    /**
     * Writes the value and a line separator to standard error.
     *
     * @param value the value to write
     */
    @Intrinsic
    static void eprintln(Object? value);

    /**
     * Writes the value and a line separator to standard error.
     *
     * @param value a reference to the value to write
     */
    @Intrinsic
    static void eprintln(&Object? value);

    /**
     * Reads a line of text from standard input.
     *
     * <p>The line separator is not included. Bytes that are not valid UTF-8
     * are replaced with {@code U+FFFD}.
     *
     * <pre>{@code
     * String? line = Console.readLine();
     * while (line != null) {
     *     Console.println(line.toUpperCase());
     *     line = Console.readLine();
     * }
     * }</pre>
     *
     * @return the line, or {@code null} at the end of the input
     */
    @Intrinsic
    static String? readLine();
}
