package std.lang;

final class Console {
    private Console() {}

    @Intrinsic
    static void print(Object? value);

    @Intrinsic
    static void print(&Object? value);

    @Intrinsic
    static void println();

    @Intrinsic
    static void println(Object? value);

    @Intrinsic
    static void println(&Object? value);

    @Intrinsic
    static void eprint(Object? value);

    @Intrinsic
    static void eprint(&Object? value);

    @Intrinsic
    static void eprintln();

    @Intrinsic
    static void eprintln(Object? value);

    @Intrinsic
    static void eprintln(&Object? value);

    @Intrinsic
    static String? readLine();
}
