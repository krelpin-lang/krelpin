package std.lang;

final class Console {
    private Console() {}

    @Intrinsic
    void print(Object? value);

    @Intrinsic
    void print(&Object? value);

    @Intrinsic
    void println();

    @Intrinsic
    void println(Object? value);

    @Intrinsic
    void println(&Object? value);

    @Intrinsic
    String? readLine();
}
