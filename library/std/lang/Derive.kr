package std.lang;

/**
 * Generates implementations of {@link Equatable}, {@link Hashable} and
 * {@link Comparable} for a class.
 *
 * <p>The generated methods consider every field in declaration order.
 * {@code equals} compares all fields, {@code hashCode} combines their hash
 * codes, and {@code compareTo} orders by the first field that differs.
 *
 * <pre>{@code
 * @Derive(Equatable, Hashable)
 * class Point {
 *     int x;
 *     int y;
 * }
 * }</pre>
 */
@Intrinsic
macro Derive;
