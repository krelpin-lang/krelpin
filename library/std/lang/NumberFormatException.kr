package std.lang;

/**
 * Thrown when a string cannot be parsed as a number of the requested type,
 * either because it is not a number or because the number does not fit in
 * the type.
 */
class NumberFormatException extends IllegalArgumentException {
    /** Constructs an exception with no detail message. */
    NumberFormatException() {
        super();
    }

    /**
     * Constructs an exception with the specified detail message.
     *
     * @param message the detail message, which describes what went wrong
     */
    NumberFormatException(String message) {
        super(message);
    }
}
