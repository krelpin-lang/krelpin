package std.lang;

final class Character implements Comparable<Character> {
    public const char MIN_VALUE = '\u0000';
    public const char MAX_VALUE = '\uffff';

    private char value;

    Character(char value) {
        this.value = value;
    }

    char charValue(&this) {
        return this.value;
    }

    int compareTo(&this, Character other) {
        return Character.compare(this.value, other.value);
    }

    int compare(char a, char b) {
        if (a < b) {
            return -1;
        }
        return a > b ? 1 : 0;
    }

    Character valueOf(char value) {
        return new Character(value);
    }

    @Intrinsic
    boolean isDigit(char c);

    @Intrinsic
    boolean isLetter(char c);

    @Intrinsic
    boolean isLetterOrDigit(char c);

    @Intrinsic
    boolean isWhitespace(char c);

    @Intrinsic
    boolean isUpperCase(char c);

    @Intrinsic
    boolean isLowerCase(char c);

    @Intrinsic
    char toUpperCase(char c);

    @Intrinsic
    char toLowerCase(char c);
}
