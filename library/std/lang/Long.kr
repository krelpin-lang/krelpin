package std.lang;

final class Long implements Comparable<Long> {
    public const long MIN_VALUE = -9223372036854775808L;
    public const long MAX_VALUE = 9223372036854775807L;

    private long value;

    Long(long value) {
        this.value = value;
    }

    long longValue(&this) {
        return this.value;
    }

    int compareTo(&this, Long other) {
        return Long.compare(this.value, other.value);
    }

    int compare(long a, long b) {
        if (a < b) {
            return -1;
        }
        return a > b ? 1 : 0;
    }

    Long valueOf(long value) {
        return new Long(value);
    }

    @Intrinsic
    long parseLong(String text);

    @Intrinsic
    String toString(long value);
}
