package std.lang;

/**
 * Formats values according to a format specification, the text after the
 * colon in an interpolation such as {@code "${value:spec}"}.
 *
 * <p>A specification has the form
 * {@code [[fill]align][+][#][0][width][.precision][type]}:
 *
 * <ul>
 * <li>{@code align} is {@code <} (left), {@code >} (right) or {@code ^}
 *     (center), and {@code fill} is the character used to pad the value to
 *     {@code width}; the default fill is a space.
 * <li>{@code +} shows the sign of positive numbers as well.
 * <li>{@code #} adds the prefix of the radix, such as {@code 0x}.
 * <li>{@code 0} pads numbers with zeros after the sign.
 * <li>{@code precision} is the number of digits after the decimal point,
 *     or the maximum number of characters of text.
 * <li>{@code type} is {@code x} or {@code X} for hexadecimal, {@code o} for
 *     octal, {@code b} for binary, or {@code e} or {@code E} for scientific
 *     notation.
 * </ul>
 *
 * <pre>{@code
 * "${42:>6}"      // "    42"
 * "${3.14159:.2}" // "3.14"
 * "${255:#x}"     // "0xff"
 * "${"hi":*^6}"   // "**hi**"
 * }</pre>
 *
 * <p>The {@code format} methods of the primitive types and
 * {@link Object#format} delegate to this class, so {@code 42.format(">6")}
 * produces the same text.
 */
final class Format {
    private Format() {}

    /**
     * Formats an integer.
     *
     * @param value the integer to format
     * @param spec the format specification
     * @return the formatted text
     * @throws IllegalArgumentException if {@code spec} is malformed or does
     *         not apply to integers
     */
    static String integer(long value, String spec) {
        String? text = formatLong(value, spec);
        if (text == null) {
            throw invalid(spec, "an integer");
        }
        return text;
    }

    /**
     * Formats a floating-point number.
     *
     * @param value the number to format
     * @param spec the format specification
     * @return the formatted text
     * @throws IllegalArgumentException if {@code spec} is malformed or does
     *         not apply to floating-point numbers
     */
    static String decimal(double value, String spec) {
        String? text = formatDouble(value, spec);
        if (text == null) {
            throw invalid(spec, "a decimal number");
        }
        return text;
    }

    /**
     * Formats text.
     *
     * <p>Only the fill, alignment, width and precision of the specification
     * apply to text.
     *
     * @param value the text to format
     * @param spec the format specification
     * @return the formatted text
     * @throws IllegalArgumentException if {@code spec} is malformed or does
     *         not apply to text
     */
    static String text(String value, String spec) {
        String? text = formatText(value, spec);
        if (text == null) {
            throw invalid(spec, "text");
        }
        return text;
    }

    private static IllegalArgumentException invalid(String spec, String what) {
        return new IllegalArgumentException("the format `" + spec + "` cannot be used on " + what);
    }

    @Intrinsic
    private static String? formatLong(long value, String spec);

    @Intrinsic
    private static String? formatDouble(double value, String spec);

    @Intrinsic
    private static String? formatText(String value, String spec);
}
