package std.io;

import std.util.ArrayList;
import std.util.List;

/**
 * Static methods for manipulating paths written as strings, with
 * {@code /} as the separator.
 *
 * <p>These methods operate only on the text of a path and never access the
 * file system.
 *
 * <pre>{@code
 * String file = Path.join("src", "main.kr"); // "src/main.kr"
 * Path.fileName(file);                       // "main.kr"
 * Path.parent(file);                         // "src"
 * Path.extension(file);                      // "kr"
 * }</pre>
 */
final class Path {
    private Path() {}

    /**
     * Joins two paths with a separator.
     *
     * <p>If {@code child} is absolute, it replaces {@code base}; if
     * {@code base} is empty, the result is {@code child}.
     *
     * @param base the base path
     * @param child the path to append
     * @return the joined path
     */
    static String join(String base, String child) {
        if (base.isEmpty() || child.startsWith("/")) {
            return child;
        }
        if (base.endsWith("/")) {
            return base + child;
        }
        return "$base/$child";
    }

    /**
     * Returns the last component of a path.
     *
     * @param path the path
     * @return the part of {@code path} after the last {@code /}, or the whole
     *         path if it contains none
     */
    static String fileName(String path) {
        path = trimEnd(path);
        int slash = path.lastIndexOf("/");
        return slash < 0 ? path : path.substring(slash + 1);
    }

    /**
     * Returns the parent of a path.
     *
     * @param path the path
     * @return the part of {@code path} before the last {@code /}; an empty
     *         string if it contains none, and {@code "/"} for a path directly
     *         under the root
     */
    static String parent(String path) {
        path = trimEnd(path);
        int slash = path.lastIndexOf("/");
        if (slash < 0) {
            return "";
        }
        return slash == 0 ? "/" : path.substring(0, slash);
    }

    /**
     * Returns the extension of the file name of a path.
     *
     * <p>A leading dot does not start an extension, so {@code .profile} has
     * none.
     *
     * @param path the path
     * @return the part of the file name after its last {@code .}, or an empty
     *         string if there is none
     */
    static String extension(String path) {
        String name = fileName(path);
        int dot = name.lastIndexOf(".");
        return dot <= 0 ? "" : name.substring(dot + 1);
    }

    static boolean isAbsolute(String path) {
        return path.startsWith("/");
    }

    static String normalize(String path) {
        boolean absolute = isAbsolute(path);
        List<String> parts = new ArrayList<>();
        for (String part : path.split("/")) {
            if (part.isEmpty() || part.equals(&".")) {
                continue;
            }
            if (part.equals(&"..")) {
                (&String)? last = parts.last();
                if (last != null && !last.equals(&"..")) {
                    parts.remove(parts.size() - 1);
                    continue;
                }
                if (absolute) {
                    continue;
                }
            }
            parts.add(part);
        }
        String joined = String.join("/", &parts);
        if (absolute) {
            return "/$joined";
        }
        return joined.isEmpty() ? "." : joined;
    }

    static String relativize(String base, String path) {
        if (isAbsolute(base) != isAbsolute(path)) {
            throw new IllegalArgumentException("`$path` and `$base` must both be absolute or both relative");
        }
        String[] from = segments(normalize(base));
        String[] to = segments(normalize(path));
        int common = 0;
        while (common < from.length && common < to.length && from[common].equals(&to[common])) {
            common++;
        }
        List<String> parts = new ArrayList<>();
        for (int i = common; i < from.length; i++) {
            if (from[i].equals(&"..")) {
                throw new IllegalArgumentException("can't find `$path` from `$base`, which leaves its starting directory");
            }
            parts.add("..");
        }
        for (int i = common; i < to.length; i++) {
            parts.add(to[i]);
        }
        String joined = String.join("/", &parts);
        return joined.isEmpty() ? "." : joined;
    }

    private static String[] segments(String normalized) {
        String relative = normalized.startsWith("/") ? normalized.substring(1) : normalized;
        if (relative.isEmpty() || relative.equals(&".")) {
            return new String[0];
        }
        return relative.split("/");
    }

    private static String trimEnd(String path) {
        while (path.length() > 1 && path.endsWith("/")) {
            path = path.substring(0, path.length() - 1);
        }
        return path;
    }
}
