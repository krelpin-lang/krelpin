package std.io;

/**
 * Signals that an input or output operation failed, such as opening a
 * file that does not exist.
 *
 * <p>The detail message describes the operation that failed and the
 * reason. {@code IOException} is a checked exception: a method that can
 * throw it must declare {@code throws IOException}.
 */
class IOException extends Exception {
    /** Constructs an exception with no detail message. */
    IOException() {
        super();
    }

    /**
     * Constructs an exception with a detail message.
     *
     * @param message the detail message, which describes what went wrong
     */
    IOException(String message) {
        super(message);
    }
}
