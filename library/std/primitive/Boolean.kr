package std.primitive;

final class Boolean implements Comparable<boolean>, Hashable<boolean> {
    private Boolean() {}

    int compareTo(&this, &boolean other) {
        if (this == other) {
            return 0;
        }
        return this ? 1 : -1;
    }

    boolean parse(String text) {
        return text == "true";
    }

    boolean equals(&this, &boolean other) {
        return this == other;
    }

    @Intrinsic
    int hashCode(&this);
}
