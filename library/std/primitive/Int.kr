package std.primitive;

/**
 * Methods and constants for `int`, a 32-bit signed integer.
 *
 * The methods are called on the values themselves:
 *
 * ```
 * int value = int.parse("-42");
 * String padded = value.format(">8");
 * ```
 *
 * Arithmetic on `int` wraps around on overflow: `int.MAX_VALUE + 1` is
 * `int.MIN_VALUE`.
 */
final class Int implements Comparable<int>, Hashable<int> {
    /** The smallest `int`, -2<sup>31</sup>. */
    public const int MIN_VALUE = -2147483648;

    /** The largest `int`, 2<sup>31</sup> - 1, which is 2147483647. */
    public const int MAX_VALUE = 2147483647;

    private Int() {}

    /** Returns a negative number, zero or a positive number when this value is smaller than, equal to or larger than `other`. */
    int compareTo(&int other) {
        if (this < other) {
            return -1;
        }
        return this > other ? 1 : 0;
    }

    /**
     * Parses a decimal number, like `"-42"` or `"+7"`.
     *
     * The text may start with `+` or `-` and must otherwise be made of the
     * digits `0` to `9` only: no spaces, underscores or prefixes like `0x`.
     *
     * # Throws
     *
     * `NumberFormatException` if the text isn't a number or the number
     * doesn't fit in a `int`.
     */
    @Intrinsic
    static int parse(String text);

    /** Returns whether this value is equal to `other`. */
    boolean equals(&int other) {
        return this == other;
    }

    /** Returns a hash of this value, consistent with `equals`. */
    @Intrinsic
    int hashCode();

    /**
     * Formats this value with a format spec, the same as `"${value:spec}"`
     * in an interpolated string.
     *
     * ```
     * 42.format(">6")  // "    42"
     * 42.format("06")  // "000042"
     * 255.format("x")  // "ff"
     * ```
     *
     * # Throws
     *
     * `IllegalArgumentException` if the spec can't be used on integers.
     */
    String format(String spec) {
        return Format.integer(this, spec);
    }
}
