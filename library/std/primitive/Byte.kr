package std.primitive;

final class Byte implements Comparable<byte>, Hashable<byte> {
    public const byte MIN_VALUE = -128;
    public const byte MAX_VALUE = 127;

    private Byte() {}

    int compareTo(&this, &byte other) {
        if (this < other) {
            return -1;
        }
        return this > other ? 1 : 0;
    }

    @Intrinsic
    byte parse(String text);

    boolean equals(&this, &byte other) {
        return this == other;
    }

    @Intrinsic
    int hashCode(&this);
}
