package std.primitive;

final class Byte implements Comparable<byte>, Hashable<byte> {
    public const byte MIN_VALUE = -128;
    public const byte MAX_VALUE = 127;

    private Byte() {}

    int compareTo(&byte other) {
        if (this < other) {
            return -1;
        }
        return this > other ? 1 : 0;
    }

    @Intrinsic
    static byte parse(String text);

    boolean equals(&byte other) {
        return this == other;
    }

    @Intrinsic
    int hashCode();

    String format(String spec) {
        return Format.integer(this, spec);
    }
}
