package std.task;

/**
 * What an executor passes to `Future.poll`: the waker of the task being
 * polled.
 */
final class Context {
    private Waker waker;

    /** Creates a context for polling a task that `waker` wakes. */
    Context(Waker waker) {
        this.waker = waker;
    }

    /**
     * Returns a waker for the task being polled. A future keeps it when it
     * returns `Poll.Pending`, and wakes it once it can make progress.
     */
    Waker waker() {
        return this.waker.copy();
    }
}
