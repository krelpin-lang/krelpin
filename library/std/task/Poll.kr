package std.task;

/**
 * The result of {@link Future#poll}: either the result of the
 * computation, or an indication that it has not finished yet.
 *
 * @param <T> the type of the result
 */
enum Poll<T> {
    /** The computation has finished with {@code value}. */
    Ready(T value),
    /**
     * The computation has not finished; the task's waker is woken when it
     * can make progress.
     */
    Pending
}
