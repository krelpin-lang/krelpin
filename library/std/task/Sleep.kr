package std.task;

/** The future `Runtime.sleep` returns: ready once its deadline has passed. */
final class Sleep implements Future<Unit> {
    private long deadline;
    private boolean armed = false;

    Sleep(long deadline) {
        this.deadline = deadline;
    }

    mut Poll<Unit> poll(&mut Context cx) {
        if (Reactor.now() >= this.deadline) {
            return Poll.Ready(new Unit());
        }
        if (!this.armed) {
            Reactor.sleepUntil(this.deadline, cx.waker().task);
            this.armed = true;
        }
        return Poll.Pending;
    }
}
