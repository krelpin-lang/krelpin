package std.task;

/**
 * The event loop under `Runtime`, one per thread. Futures written by hand
 * use it to be woken: `sleepUntil` for a time, and `waitFd` (through
 * `std.net.Readiness`) for a socket. Everything else goes through
 * `Runtime`.
 *
 * Tasks are numbered: 0 is the future `Runtime.blockOn` runs, and spawned
 * tasks count up from 1. `Context.waker()` knows the number of the task
 * being polled.
 */
final class Reactor {
    private Reactor() {}

    /** Milliseconds on a clock that only goes forward. */
    @Intrinsic
    static long now();

    /** Wakes `task` at time `deadline`, in the milliseconds of `now`. */
    @Intrinsic
    static void sleepUntil(long deadline, int task);

    /**
     * Wakes `task` once the descriptor `fd` is ready for `interest`, a
     * combination of the `std.net.Interest` constants. Returns false if the
     * system refuses, with the reason in `Files.lastError()`.
     */
    @Intrinsic
    static boolean waitFd(int fd, int interest, int task);

    /** Schedules `task` to be polled again. */
    @Intrinsic
    static void wake(int task);

    /** Starts the reactor of this thread; false if it is running already. */
    @Intrinsic
    static boolean enter();

    /** Drops the spawned tasks that are left and stops the reactor. */
    @Intrinsic
    static void exit();

    /** The next woken task, or -1 if none is left. */
    @Intrinsic
    static int nextWoken();

    /**
     * Waits until some task is woken. Returns false if that can never
     * happen, because no task waits for a socket or a time.
     */
    @Intrinsic
    static boolean turn();

    /** Adds a task that runs `future`, or returns -1 without a reactor. */
    @Intrinsic
    static int spawn(Future<Unit> future) keeps future;

    /** Takes out the future of a spawned task to poll it. */
    @Intrinsic
    static Future<Unit>? take(int task);

    /** Puts back the future of a spawned task that isn't finished. */
    @Intrinsic
    static void put(int task, Future<Unit> future) keeps future;

    /** Ends a spawned task whose future was taken out. */
    @Intrinsic
    static void finish(int task);
}
