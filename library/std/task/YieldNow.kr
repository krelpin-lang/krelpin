package std.task;

/** The future `Runtime.yieldNow` returns. */
final class YieldNow implements Future<Unit> {
    private boolean yielded = false;

    YieldNow() {}

    mut Poll<Unit> poll(&mut Context cx) {
        if (this.yielded) {
            return Poll.Ready(new Unit());
        }
        this.yielded = true;
        cx.waker().wake();
        return Poll.Pending;
    }
}
