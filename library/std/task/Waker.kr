package std.task;

/**
 * Tells an executor to poll a task again.
 *
 * Executors implement this interface, and futures use it: a future that
 * returns `Poll.Pending` keeps the waker from `Context.waker()`, and calls
 * `wake` when the thing it waits for has happened, for example from a
 * timer or when a socket becomes ready.
 */
interface Waker {
    /**
     * Schedules the task to be polled again. Waking a task that is already
     * scheduled doesn't poll it twice.
     */
    void wake();

    /** Returns a waker for the same task. */
    Waker copy();
}
