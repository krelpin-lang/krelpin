package std.net;

import std.io.IOException;
import std.io.OsError;
import std.util.ArrayList;
import std.util.List;

/**
 * Waits for readiness events on a set of non-blocking sockets, so that a
 * single thread can serve many connections.
 *
 * <p>The poller uses epoll on Linux and kqueue on macOS and the BSDs.
 *
 * <p>Register each socket with a token of your choice and the
 * {@link Interest} to report, then call {@link #poll} in a loop and handle
 * the sockets it reports:
 *
 * <pre>{@code
 * Poller poller = Poller.create();
 * TcpListener listener = TcpListener.bind("127.0.0.1:8080");
 * listener.setNonBlocking(true);
 * listener.register(&mut poller, 0, Interest.READABLE);
 *
 * Map<int, TcpStream> clients = new HashMap<>();
 * int next = 1;
 * while (true) {
 *     for (Event event : poller.poll(-1)) {
 *         if (event.token() == 0) {
 *             TcpStream? client = listener.tryAccept();
 *             if (client != null) {
 *                 client.register(&mut poller, next, Interest.READABLE);
 *                 clients.put(next, client);
 *                 next++;
 *             }
 *             continue;
 *         }
 *         TcpStream? client = clients.remove(&event.token());
 *         if (client == null) {
 *             continue;
 *         }
 *         String? line = client.tryReadLine();
 *         while (line != null) {
 *             client.queue("you said: $line\n");
 *             line = client.tryReadLine();
 *         }
 *         client.flush();
 *         if (!client.atEnd()) {
 *             clients.put(event.token(), client); // dropping it closes it
 *         }
 *     }
 * }
 * }</pre>
 *
 * <p>Polling is level-triggered: a socket that still has unread data is
 * reported again by the next call to {@code poll}, so a handler may read
 * only part of it. Register for {@code Interest.WRITABLE} only while there
 * is data to send, because a socket with room in its send buffer is
 * reported as writable on every call.
 *
 * <p>A socket is removed from the poller when the socket is dropped, and
 * the poller is closed when it is dropped.
 */
final class Poller {
    private Poller() {}

    /**
     * Creates a poller.
     *
     * @return a new poller with no registered sockets
     * @throws IOException if the process has no free descriptors, or the
     *         system supports neither epoll nor kqueue
     */
    static Poller create() throws IOException {
        Poller poller = new Poller();
        if (!poller.createRaw()) {
            throw new IOException("couldn't create a poller: ${OsError.message()}");
        }
        return poller;
    }

    /**
     * Waits until at least one registered socket is ready or the timeout
     * expires.
     *
     * <p>A negative timeout waits indefinitely, and a timeout of 0 returns
     * immediately. The returned list is empty if the timeout expires or the
     * wait is interrupted by a signal.
     *
     * @param timeoutMillis the maximum time to wait, in milliseconds
     * @return the events of the ready sockets, with at most one event per token
     * @throws IOException if the underlying system call fails
     */
    mut List<Event> poll(long timeoutMillis) throws IOException {
        int count = this.pollRaw(timeoutMillis);
        if (count < 0) {
            throw new IOException("couldn't poll: ${OsError.message()}");
        }
        List<Event> events = new ArrayList<>();
        for (int i = 0; i < count; i++) {
            int flags = this.flagsRaw(i);
            events.add(new Event(
                this.tokenRaw(i),
                (flags & 1) != 0,
                (flags & 2) != 0,
                (flags & 4) != 0,
                (flags & 8) != 0
            ));
        }
        return events;
    }

    @Intrinsic
    private mut boolean createRaw();

    @Intrinsic
    private mut int pollRaw(long millis);

    @Intrinsic
    private int tokenRaw(int index);

    @Intrinsic
    private int flagsRaw(int index);
}
