package std.net;

/**
 * Constants for the readiness a socket is registered for with a
 * {@link Poller}.
 *
 * <p>The constants can be combined with {@code |}:
 *
 * <pre>{@code
 * stream.register(&mut poller, 7, Interest.READABLE | Interest.WRITABLE);
 * }</pre>
 */
final class Interest {
    private Interest() {}

    /**
     * Reports the socket when a read, {@code tryAccept} or
     * {@code tryReceive} would not block.
     */
    public const int READABLE = 1;

    /**
     * Reports the socket when a write would not block, and when a connection
     * started with {@link TcpStream#startConnect} has completed or failed.
     */
    public const int WRITABLE = 2;

    static void check(int interest) {
        if (interest <= 0 || interest > (Interest.READABLE | Interest.WRITABLE)) {
            throw new IllegalArgumentException("$interest is not a combination of `Interest` constants");
        }
    }
}
