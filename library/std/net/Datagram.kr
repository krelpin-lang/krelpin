package std.net;

/**
 * A message received by a {@link UdpSocket}, together with the address of
 * its sender.
 *
 * <pre>{@code
 * Datagram message = socket.receive(1500);
 * socket.send(message.data(), message.sender().toString()); // echo it back
 * }</pre>
 *
 * @param data the content of the message
 * @param sender the address the message was sent from
 */
record Datagram(byte[] data, SocketAddr sender) {
    /**
     * Decodes the content of this message as UTF-8 text.
     *
     * @return the text, or {@code null} if the content is not valid UTF-8
     */
    String? text() {
        return String.fromUtf8(&this.data);
    }
}
