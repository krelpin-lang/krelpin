package std.function;

/**
 * A boolean-valued function of one argument, such as {@code n -> n > 0}.
 *
 * @param <T> the type of the argument
 */
interface Predicate<T> {
    /**
     * Evaluates this predicate on an argument.
     *
     * @param value the argument
     * @return {@code true} if the argument satisfies the predicate
     */
    mut boolean test(T value);
}
