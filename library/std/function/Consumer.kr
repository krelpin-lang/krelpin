package std.function;

/**
 * A function that accepts a single argument and returns no result, such
 * as {@code x -> Console.println(x)}.
 *
 * @param <T> the type of the argument
 */
interface Consumer<T> {
    /**
     * Performs this operation on an argument.
     *
     * @param value the argument
     */
    mut void accept(T value);
}
