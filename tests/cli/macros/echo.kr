package echo;

import std.macros.Item;
import std.macros.Member;
import std.macros.MacroError;
import std.macros.TokenStream;

macro Echo(TokenStream args, TokenStream input) {
    Item item = Item.parse(&input);
    String summary = item.kind() + " " + item.name().text + ":";
    for (&Member member : item.members()) {
        summary = summary + " " + member.kind() + "(" + member.name().text + ")";
    }
    for (&Member component : item.components()) {
        summary = summary + " component(" + component.type() + " " + component.name().text + ")";
    }
    Console.println(summary);
    TokenStream output = item.toTokens();
    if (!output.toString().equals(&input.toString())) {
        throw new MacroError("round trip changed the item: " + output);
    }
    return output;
}

macro Inspect(TokenStream args, TokenStream input) {
    Member member = Member.parse(&input);
    Console.println(member.kind() + " " + member.name().text + " type=[" + member.type()
        + "] params=[" + member.params() + "] init=[" + member.initializer() + "]");
    return member.toTokens();
}
