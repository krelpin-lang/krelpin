import std.io.IOException;
import std.net.TcpListener;
import std.net.TcpStream;

class Main {
    static int openAndDrop() throws IOException {
        TcpListener listener = TcpListener.bind("127.0.0.1:0");
        return listener.localAddr().port();
    }

    static void main() throws IOException {
        // Dropping a listener closes it, so its port can be bound again.
        int port = Main.openAndDrop();
        TcpListener again = TcpListener.bind("127.0.0.1:$port");
        Console.println("rebound after drop: ${again.localAddr().port() == port}");

        // A host name is resolved.
        TcpStream viaName = TcpStream.connect("localhost:$port");
        TcpStream accepted = again.accept();
        Console.println("connected through localhost");

        // Writing after the peer has gone throws instead of killing us.
        {
            TcpStream gone = accepted;
        }
        int failures = 0;
        for (int i = 0; i < 50; i++) {
            try {
                viaName.write("x".repeat(65536));
            } catch (IOException e) {
                failures++;
                break;
            }
        }
        Console.println("write to closed peer threw: ${failures == 1}");
    }
}
