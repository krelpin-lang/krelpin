import std.io.Files;
import std.io.IOException;
import std.io.Path;
import std.util.ArrayList;
import std.util.HashMap;
import std.util.List;
import std.util.Map;

class Main {
    static void lists() {
        List<String> names = new ArrayList<>();
        names.add("ada");
        names.add("bob");
        List<String> more = new ArrayList<>();
        more.add("cyd");
        more.add("dee");
        names.addAll(more);
        Console.println("$names");
        Console.println(names.find(name -> name.startsWith("c")));
        Console.println(names.find(name -> name.startsWith("z")) == null);
        Console.println("${names.findIndex(name -> name.equals(&"bob"))} ${names.any(name -> name.length() == 3)} ${names.all(name -> name.contains('a'))}");
        Console.println(names.count(name -> name.contains('d')));
        List<int> lengths = names.map(name -> name.length() * 10);
        Console.println("$lengths");
        Console.println(names.filter(name -> !name.equals(&"bob")));
        Console.println(names.subList(1, 3));
        Console.println(String.join(" + ", &names));
    }

    static void maps() {
        Map<String, int> ages = new HashMap<>();
        Console.println(ages.putIfAbsent("ada", 36));
        Console.println(ages.putIfAbsent("ada", 99));
        ages.put("bob", 41);
        Console.println("${ages.get(&"ada")} ${ages.containsValue(&41)} ${ages.containsValue(&7)}");
        int[] total = {0};
        ages.forEach((name, age) -> total[0] = total[0] + age);
        Console.println(total[0]);
    }

    static void strings() {
        String text = "key=value=more";
        String[] two = text.split("=", 2);
        Console.println("${two.length} ${two[0]} ${two[1]}");
        Console.println(text.split("=", 0).length);
        Console.println("${text.indexOf('v')} ${text.contains('z')}");
        char letter = true ? 'x' : 'y';
        Console.println(letter);
    }

    static void numbers() {
        Console.println("${int.parse("ff", 16)} ${int.parse("-101", 2)} ${long.parse("zz", 36)}");
        Console.println("${255.toString(16)} ${(-10).toString(2)} ${long.toString(long.MIN_VALUE, 16)}");
        Console.println("${'7'.digit(10)} ${'f'.digit(16)} ${'g'.digit(16)} ${char.forDigit(11, 16)}");
        try {
            int.parse("80000000", 16);
        } catch (NumberFormatException error) {
            Console.println(error.getMessage());
        }
        try {
            int.parse("12x", 10);
        } catch (NumberFormatException error) {
            Console.println(error.getMessage());
        }
        Console.println(Math.addExact(1, 2) + Math.multiplyExact(3, 4));
        try {
            Math.addExact(int.MAX_VALUE, 1);
        } catch (ArithmeticException error) {
            Console.println(error.getMessage());
        }
        try {
            Math.multiplyExact(long.MAX_VALUE, 2L);
        } catch (ArithmeticException error) {
            Console.println(error.getMessage());
        }
        Console.println("${Math.floorMod(-7, 3)} ${Math.floorMod(7, -3)} ${Math.subtractExact(5L, 7L)}");
    }

    static void paths() {
        Console.println("${Path.fileName("a/b/")} ${Path.parent("a/b/")} ${Path.isAbsolute("/x")}");
        Console.println("${Path.normalize("a/./b/../c//d/")} ${Path.normalize("/../x/..")} ${Path.normalize("../a/..")} ${Path.normalize("")}");
        Console.println("${Path.relativize("/a/b", "/a/c/d")} ${Path.relativize("a", "a")} ${Path.relativize("x/y", "x")}");
    }

    static void files() throws IOException {
        String dir = Files.createTempDirectory("krelpin-std-");
        Console.println(Files.isDirectory(dir));
        String data = Path.join(dir, "data.bin");
        byte[] bytes = {1, 2, 0, -1};
        Files.writeBytes(data, &bytes);
        byte[] more = {7};
        Files.appendBytes(data, &more);
        byte[] read = Files.readBytes(data);
        Console.println("${read.length} ${read[3]} ${read[4]}");
        Files.createDirectory(Path.join(dir, "sub"));
        Files.copy(data, Path.join(dir, "sub/copy.bin"));
        Files.move(Path.join(dir, "sub/copy.bin"), Path.join(dir, "sub/moved.bin"));
        Console.println("${Files.exists(Path.join(dir, "sub/copy.bin"))} ${Files.size(Path.join(dir, "sub/moved.bin"))} ${Files.isSymlink(data)}");
        try {
            Files.createDirectory(Path.join(dir, "sub"));
        } catch (IOException error) {
            Console.println("exists");
        }
        Files.deleteRecursively(dir);
        Console.println(Files.exists(dir));
        Console.println(System.osName().length() > 0);
        Console.println(System.homeDirectory() != null);
    }

    static void main() throws IOException {
        Main.lists();
        Main.maps();
        Main.strings();
        Main.numbers();
        Main.paths();
        Main.files();
    }
}
