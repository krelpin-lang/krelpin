import std.net.SocketAddr;
class Main {
    static void attempt(String ip, int port) {
        try {
            SocketAddr a = new SocketAddr(ip, port);
            Console.println("ok $a");
        } catch (IllegalArgumentException e) {
            Console.println("rejected: ${e.getMessage()}");
        }
    }
    static void parse(String text) {
        try {
            Console.println("parsed ${SocketAddr.parse(text)} port ${SocketAddr.parse(text).port()}");
        } catch (IllegalArgumentException e) {
            Console.println("rejected: ${e.getMessage()}");
        }
    }
    static void main() {
        Main.attempt("127.0.0.1", 80);
        Main.attempt("nonsense", 80);
        Main.attempt("127.0.0.1", 99999);
        Main.attempt("256.1.1.1", 1);
        Main.attempt("1.2.3", 1);
        Main.attempt("::1", 443);
        Main.attempt("fe80::1:2", 8080);
        Main.attempt("2001:db8:0:0:0:0:2:1", 1);
        Main.attempt("::ffff:192.168.0.1", 1);
        Main.attempt("1::2::3", 1);
        Main.attempt("[::1]", 1);
        Main.attempt("12345::", 1);
        Main.attempt("fe80::1%en0", 1);
        Main.attempt("fe80::1%", 1);
        Main.parse("[::1]:8080");
        Main.parse("10.0.0.1:65535");
        Main.parse("host.example:80");

        // `with` runs the same checks as the constructor.
        SocketAddr base = SocketAddr.parse("10.0.0.1:80");
        Console.println(base with { port = 8080 });
        try {
            Console.println(base with { port = 99999 });
        } catch (IllegalArgumentException e) {
            Console.println("rejected: ${e.getMessage()}");
        }
    }
}
