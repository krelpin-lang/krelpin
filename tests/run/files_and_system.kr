import std.io.FileReader;
import std.io.FileWriter;
import std.io.Files;
import std.io.IOException;
import std.io.Path;

class Main {
    static void main() throws IOException {
        String base = Path.join(System.env("TMPDIR") ?: "/tmp", "krelpin-io-${System.nanoTime()}");
        String dir = Path.join(base, "nested/deeper");
        Files.createDirectories(dir);
        String notes = Path.join(dir, "notes.txt");
        Files.writeString(notes, "satır 1\nsatır 2\n");
        Files.appendString(notes, "satır 3\n");
        Console.print(Files.readString(notes));
        Console.println("lines=${Files.readLines(notes).length} size=${Files.size(notes)}");
        Console.println("file=${Files.isFile(notes)} dir=${Files.isDirectory(dir)}");

        String log = Path.join(dir, "log.txt");
        {
            FileWriter writer = FileWriter.create(log);
            for (int i = 0; i < 3; i++) {
                writer.writeLine("entry $i");
            }
        }
        FileWriter more = FileWriter.append(log);
        more.write("last");
        more.flush();
        FileReader reader = FileReader.open(log);
        String? line = reader.readLine();
        while (line != null) {
            Console.println("read: $line");
            line = reader.readLine();
        }
        FileReader whole = FileReader.open(notes);
        Console.println("all=${whole.readAll().length()} chars");

        for (String name : Files.list(dir)) {
            Console.println("entry ${name:>10} ext=${Path.extension(name)}");
        }
        Console.println("${Path.fileName(notes)} | ${Path.fileName(Path.parent(notes))}");
        String hidden = Path.extension(".hidden");
        Console.println("[${Path.parent("top")}] [${Path.parent("/top")}] [$hidden]");

        try {
            Files.readString(Path.join(base, "missing.txt"));
        } catch (IOException error) {
            Console.println((error.getMessage() ?: "").endsWith("No such file or directory"));
        }
        try {
            FileReader.open(Path.join(base, "missing.txt"));
        } catch (IOException error) {
            Console.println((error.getMessage() ?: "").startsWith("couldn't open"));
        }

        Files.delete(notes);
        Files.delete(log);
        Files.delete(dir);
        Files.delete(Path.parent(dir));
        Files.delete(base);
        Console.println("cleaned=${!Files.exists(base)}");

        Console.eprintln("to stderr");
        Console.println("env=${System.env("KRELPIN_SURELY_UNSET_VARIABLE") ?: "unset"}");
        long start = System.nanoTime();
        Console.println("clock=${System.currentTimeMillis() > 0 && System.nanoTime() >= start}");
        System.exit(3);
    }
}
