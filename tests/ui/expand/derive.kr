package shop;

@Derive(Comparable)
record Money(long cents, String currency) {}

@Derive(Equatable, Hashable)
enum Payment {
    Card(String number, Money amount),
    Cash(Money amount),
    Voucher(String? code),
    Free;
}

@Derive(Equatable)
enum Tree<T extends Equatable<T>> {
    Leaf(T value),
    Node(Tree<T> left, Tree<T> right);
}

@Derive(Comparable)
enum Priority {
    Low,
    Normal,
    Urgent;
}

class Register {
    HashMap<Payment, int> counts = new HashMap<>();

    mut void track(Payment payment) {
        int? count = this.counts.get(&payment);
        this.counts.put(payment, (count ?: 0) + 1);
    }

    static boolean same(Money a, Money b) {
        return a == b;
    }

    static String cheaper(Money a, Money b) {
        Money cheapest = a.compareTo(&b) <= 0 ? a : b;
        return "cheapest: " + cheapest.toString();
    }

    static Money tip() {
        return new Money(500, "TRY");
    }

    static boolean urgent(Priority priority) {
        return priority.compareTo(&Priority.Normal) > 0;
    }
}
