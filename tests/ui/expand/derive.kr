package shop;

@Derive(Equatable, Hashable)
class Money {
    long cents;
    String currency;

    Money(long cents, String currency) {
        this.cents = cents;
        this.currency = currency;
    }
}

@Derive(Equatable, Hashable)
enum Payment {
    Card(String number, Money amount),
    Cash(Money amount),
    Voucher(String? code),
    Free;
}

@Derive(Equatable)
enum Tree<T extends Equatable<T>> {
    Leaf(T value),
    Node(Tree<T> left, Tree<T> right);
}

class Register {
    HashMap<Payment, int> counts = new HashMap<>();

    void record(&mut this, Payment payment) {
        int? count = this.counts.get(payment);
        this.counts.put(payment, (count ?: 0) + 1);
    }

    boolean same(Money a, Money b) {
        return a == b;
    }
}
