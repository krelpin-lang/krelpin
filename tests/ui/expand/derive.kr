package shop;

@Constructor
@ToString
@Derive(Equatable, Hashable, Comparable)
class Money {
    long cents;
    String currency;
}

@ToString
@Derive(Equatable, Hashable)
enum Payment {
    Card(String number, Money amount),
    Cash(Money amount),
    Voucher(String? code),
    Free;
}

@Derive(Equatable)
enum Tree<T extends Equatable<T>> {
    Leaf(T value),
    Node(Tree<T> left, Tree<T> right);
}

@Derive(Comparable)
enum Priority {
    Low,
    Normal,
    Urgent;
}

class Register {
    HashMap<Payment, int> counts = new HashMap<>();

    void record(&mut this, Payment payment) {
        int? count = this.counts.get(payment);
        this.counts.put(payment, (count ?: 0) + 1);
    }

    boolean same(Money a, Money b) {
        return a == b;
    }

    String cheaper(Money a, Money b) {
        Money cheapest = a.compareTo(&b) <= 0 ? a : b;
        return "cheapest: " + cheapest.toString();
    }

    Money tip() {
        return new Money(500, "TRY");
    }

    boolean urgent(Priority priority) {
        return priority.compareTo(&Priority.Normal) > 0;
    }
}
