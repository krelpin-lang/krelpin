package shop;

macro Builder;

@Builder
class Order {
    @Derive(Equatable)
    int total(&this) {
        return 0;
    }
}

@Derive(Equatable, Comparable)
struct Line {
    int quantity;
}

@Derive(Equatable)
enum Status {
    Open,
    Closed;
}

@Derive(Equatable)
interface Named {}

@Constructor
enum Kind {
    Small(int size);
}

@ToString(verbose)
class Note {}

@Derive(Comparable)
class Label {
    String? text;
}
