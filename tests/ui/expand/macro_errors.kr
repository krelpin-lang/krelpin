package shop;

macro Builder;

@Builder
class Order {
    @Derive(Equatable)
    int total() {
        return 0;
    }
}

@Derive(Equatable, Comparable)
record Line(int quantity) {}

@Derive(Equatable)
enum Status {
    Open,
    Closed;
}

@Derive(Equatable)
interface Named {}

@Derive(Comparable)
class Label {
    String? text;
}
