package shop;

import std.sync.Mutex;
import std.util.ArrayList;
import std.util.List;

class Main {
    static Mutex<List<Runnable>> TASKS = new Mutex<>(new ArrayList<>());
    static Runnable HOOK = () -> Console.println("hook");
    static Mutex<List<String>> NAMES = new Mutex<>(new ArrayList<>());
    static int LIMIT = 10;

    static void main() {
        Console.println(Main.LIMIT);
    }
}
