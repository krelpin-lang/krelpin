package geometry;

class Handle {}

record Point(double x, double y) {}

record Holder(Handle handle) {}

record Pair<A, B>(A first, B second) {}

class Main {
    static boolean compare(Holder a, Holder b, Pair<String, int> p) {
        return a == b || p == p;
    }

    static double first(Point point) {
        return switch (point) {
            case Point(double x) -> x;
        };
    }

    static double positive(Point point) {
        return switch (point) {
            case Point(double x, _) when x > 0.0 -> x;
        };
    }

    static void move(Point point) {
        point.x = 1.0;
    }
}
