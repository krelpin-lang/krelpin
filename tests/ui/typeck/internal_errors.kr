package shop;

import std.io.Files;
import std.util.HashSet;

class Stock {
    internal int count = 3;

    internal static int limit() {
        return 10;
    }

    internal (&String)? first(&String name) {
        return name;
    }
}

class Main {
    static void main() {
        HashSet<String> names = new HashSet<>();
        names.add("tea");
        Console.println(names.slotCount());
        Console.println(Files.lastError());
        for (&String name : names) {
            Console.println(name);
        }

        Stock stock = new Stock();
        Console.println(stock.count + Stock.limit());
        int internal = 1;
        Console.println(internal);
    }
}
