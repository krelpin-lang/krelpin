package geometry;

enum Shape {
    Circle(double radius),
    Rect(double width, double height),
    Empty;
}

enum Order {
    Placed(Shape item, int quantity),
    Cancelled(String reason),
    Delivered;
}

class Errors {
    void create() {
        Shape a = Shape.Circle("wide");
        Shape b = Shape.Rect(1.0);
        Shape c = Shape.Circle;
        Shape d = Shape.Empty();
        Order e = Order.Placed(Shape.Empty, "two");
        boolean same = a == b;
    }

    static double area(Shape shape) {
        return switch (shape) {
            case Circle(int r) -> r;
            case Rect(double w) -> w;
            case Empty(double e) -> e;
            case Square -> 0.0;
            case Circle -> 0.0;
        };
    }

    static String name(Order order) {
        return switch (order) {
            case Placed(Circle(_), int quantity) -> "circles";
            case Cancelled(_), Delivered -> "done";
        };
    }

    static void check(Shape shape, int n, boolean flag) {
        switch (shape) {
            case Circle(double r) when r > 1.0 -> {}
            case Rect(_, _) -> {}
        }
        String size = switch (n) {
            case 1, 2 -> "small";
            case 2 -> "two";
            default -> "big";
        };
        String answer = switch (flag) {
            case true -> "yes";
        };
        String kind = switch (shape) {
            default -> "any";
            case Empty -> "empty";
        };
    }
}
