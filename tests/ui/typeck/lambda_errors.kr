interface Transform<A, B> {
    B apply(A value);
}

class Main {
    static void main() {
        Transform<String, int> length = text -> text.lenght();
        Transform<String, int> pair = (a, b) -> 1;
        Transform<String, int> missing = text -> {
            Console.println(text);
        };
        String notAFunction = () -> 1;
        Transform<String, int> size = String::size;
    }
}
