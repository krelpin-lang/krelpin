interface Transform<A, B> {
    B apply(&this, A value);
}

class Main {
    void main() {
        Transform<String, Integer> length = text -> text.lenght();
        Transform<String, Integer> pair = (a, b) -> 1;
        Transform<String, Integer> missing = text -> {
            Console.println(text);
        };
        String notAFunction = () -> 1;
        Transform<String, Integer> size = String::size;
    }
}
