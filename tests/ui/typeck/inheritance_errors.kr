interface Shape {
    double area();

    int sides();
}

class Base {
    void draw() {}

    final void reset() {}

    Base copy() {
        return new Base();
    }
}

class Square extends Base implements Shape {
    double area() {
        return 1.0;
    }

    mut void draw() {}

    void reset() {}

    String copy() {
        return "";
    }
}

class Text extends String {}

class Wrong extends Shape {}
