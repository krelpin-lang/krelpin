package shop;

import std.util.ArrayList;

record Money(long cents, String currency) {}

enum Payment {
    Card(String number, Money amount),
    Cash(Money amount),
    Free;
}

class Register {
    ArrayList<Money> history = new ArrayList<>();
    int count;

    Register(int count) {
        this.count = count;
    }

    mut void track(Payment payment) {
        switch (payment) {
            case Card(String number, Money amount) when amount.cents() > 0 -> {
                this.history.add(amount);
            }
            case Card(_, _) -> {}
            case Cash(Money amount) -> this.history.add(amount);
            case Free -> {}
        }
        this.count++;
    }

    long total() {
        long sum = 0;
        for (Money money : this.history) {
            sum += money.cents();
        }
        for (int i = 0; i < this.count; i++) {
            if (i > 10) {
                break;
            }
        }
        return sum;
    }

    String describe(Payment payment) {
        return switch (payment) {
            case Card(_, Money amount) -> "card " + amount.currency().length();
            case Cash(_) -> "cash";
            case Free -> this.label("free", "no", "charge");
        };
    }

    String label(String... parts) {
        int[] sizes = new int[parts.length];
        return parts.length > 0 ? parts[0] : "";
    }
}
