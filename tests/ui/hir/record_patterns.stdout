fn Main.width(line_0: Line) -> double {
    return switch line_0 {
        Line(Point(x1_1: double, _), Point(x2_2: double, _)) if (x2_2 > x1_1) => (x2_2 - x1_1)
        Line(Point(x1_3: double, _), Point(x2_4: double, _)) => (x1_3 - x2_4)
    };
}

fn Main.sameStart(a_0: Line, b_1: Line) -> boolean {
    return Equatable::equals(&Line::from(&a_0), &Line::from(&b_1));
}

fn Main.originX(any_0: Object) -> double {
    if ((any_0 is Point(x_1: double, y_2: double)) && (y_2 == 0.0)) {
        return x_1;
    }
    return 0.0;
}

