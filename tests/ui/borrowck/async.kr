import std.task.Context;
import std.task.Future;
import std.task.Poll;
import std.task.Unit;

class Ready implements Future<Unit> {
    Ready() {}

    mut Poll<Unit> poll(&mut Context cx) {
        return Poll.Ready(new Unit());
    }
}

class Tasks {
    // Keeps `task` with no object to keep it in, like an executor's spawn.
    static void detach(Future<Unit> task) keeps task {}
}

class Main {
    static async int length(&String text) {
        await new Ready();
        return text.length();
    }

    static async void show(&String text) {
        await new Ready();
        Console.println(text);
    }

    static Future<int> escapes() {
        String text = "local";
        return Main.length(&text);
    }

    static async void spawnsBorrowed() {
        String text = "local";
        Tasks.detach(Main.show(&text));
    }

    static async void spawnsOwned(String text) {
        Tasks.detach(Main.show(&text));
    }

    static async void heldAcrossAwait() {
        String text = "a";
        &String view = &text;
        await new Ready();
        text = "b";
        Console.println(view);
    }

    static async void releasedBeforeAwait() {
        String text = "a";
        &mut String view = &mut text;
        await new Ready();
        Console.println(view);
        text = "b";
        Console.println(text);
    }

    static void futureHoldsLoan() {
        String text = "a";
        Future<int> future = Main.length(&text);
        text = "b";
        Console.println(future);
    }

    static void main() {}
}
