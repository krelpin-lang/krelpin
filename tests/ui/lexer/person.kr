package example;

import example.test;

/** A person with a name. */
class Person {
    const int MAX_NAME_LENGTH = 64;
    shared AtomicInt created = new AtomicInt(0);

    String name;
    String? nickname;

    Person(String name) {
        this.name = name;
        this.nickname = null;
        Person.created.increment();
    }

    &String getName(&this) {
        return &this.name;
    }

    void rename(&mut this, String newName) {
        this.name = newName;
    }

    int nicknameLength(&this) {
        return this.nickname?.length() ?: 0;
    }
}

class Main {
    void main() {
        Person p = new Person("Ali");
        p.rename("Veli");
        Console.println(p.getName());
    }
}
