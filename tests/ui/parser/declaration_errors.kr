struct Old {
    int x;
}

record Point(int x) extends Base {
    int y;
    Point(int x) {}
    mut void shift() {}
}

interface Named implements Other {
    String name;
    Named() {}
}

abstract final class Broken {
    void missingBody();
    abstract void withBody() {}
}

enum Level {
    LOW(1),
    HIGH();

    int value;

    Level(int value) {}
}
