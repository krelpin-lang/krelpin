struct Old {
    int x;
}

record Point(int x) extends Base {
    int y;
    Point(int x) {}
    void move(&mut this) {}
}

interface Named implements Other {
    String name;
    Named() {}
}

abstract final class Broken {
    void missingBody(&this);
    abstract void withBody(&this) {}
}

enum Level {
    LOW(1),
    HIGH();

    int value;

    Level(int value) {}
}
