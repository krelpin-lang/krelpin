package shapes;

interface Shape extends Comparable<Shape> {
    const int MAX_SIDES = 12;

    double area(&this);

    String describe(&this) {
        return switch (this.sides()) {
            case 3 -> "triangle";
            case 4 -> "quadrilateral";
            default -> {
                yield "polygon";
            }
        };
    }

    int sides(&this);
}

record Point(double x, double y) implements Shape {
    Point {
        if (x < 0.0) {
            throw new IllegalArgumentException("x");
        }
    }

    double length(&this) {
        return Math.sqrt(this.x * this.x + this.y * this.y);
    }
}

record Empty();

enum Paint {
    Solid(String hex),
    Gradient(String from, String to),
    Clear;

    const String DEFAULT = "#000000";

    boolean isClear(&this) {
        return this.ordinal() == 2;
    }
}

enum Result<T, E> {
    Ok(T value),
    Err(E error);
}

abstract class Polygon implements Shape {
    static AtomicInt created = new AtomicInt(0);
    public static AtomicInt drawn = new AtomicInt(0);

    Point[] points;

    abstract double area(&this);

    final int sides(&this) {
        return this.points.length;
    }
}
